# Copy to frontend/.env.local. On Render, set public build-time environment variables.
VITE_API_URL=http://localhost:8000

# Set disabled for the first public release. Fake login is available only in the dev server.
# VITE_AUTH_MODE=disabled

# Supabase Auth (future account release; never put the service-role key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
