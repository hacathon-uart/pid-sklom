    "source_url": "https://uk.wikipedia.org/wiki/%D0%92%D0%B5%D1%81%D1%96%D0%BB%D0%BB%D1%8F_%D0%B2_%D0%9A%D0%B8%D1%97%D0%B2%D1%81%D1%8C%D0%BA%D1%96%D0%B9_%D0%B3%D1%83%D0%B1%D0%B5%D1%80%D0%BD%D1%96%D1%97",
