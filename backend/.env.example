# Copy to backend/.env for local dev. On Render, set these in the dashboard. Never commit real keys.

# --- Switches: every external dependency has a local stub so nobody is blocked ---
DATA_BACKEND=local        # local = data/seed/*.json | supabase
AI_PROVIDER=stub          # stub = tag matching + fallback captions | llm
AUTH_MODE=stub            # stub = local fake users | disabled = no accounts | supabase = verify JWT
ENVIRONMENT=development   # production rejects fake auth, local data and unreviewed content

# Public URL of this backend (used to build image URLs and the Telegram webhook URL)
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_ORIGINS=http://localhost:5173

# --- Supabase (DATA_BACKEND=supabase / AUTH_MODE=supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
# Match the project's actual signing algorithm. HS256 additionally needs the legacy secret.
SUPABASE_JWT_ALGORITHM=ES256
# Enable only after data/migrations/0001_auth_operations.sql and real Google auth are ready.
GUEST_LIMIT_ENABLED=false
# Separate distinct-PNG download/share allowance; apply 0002_guest_exports.sql first.
GUEST_EXPORT_LIMIT_ENABLED=false
GUEST_TOKEN_SECRET=
# Signs quiz run tokens (ADR 0008). Empty = GUEST_TOKEN_SECRET, or a per-process secret locally.
QUIZ_TOKEN_SECRET=

# --- AI (AI_PROVIDER=llm) ---
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_S=8
MATCH_MODE=embeddings
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT_S=3

# --- Telegram (bot is disabled when the token is empty) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me
# Comma-separated positive Telegram user IDs. Required with a token; empty never means public access.
TELEGRAM_ALLOWED_USER_IDS=
# Webhook uses the secret in both the existing path and Telegram's secret-token header.
# Choose 1–256 characters from A-Z, a-z, 0-9, _ and -; do not use change-me.
# HTTPS enables webhook registration. Use a separate test token for local polling.
# Invalid bot configuration blocks startup; Telegram registration failures are reported
# in /api/health.bot_webhook_ready without taking down the website API.
